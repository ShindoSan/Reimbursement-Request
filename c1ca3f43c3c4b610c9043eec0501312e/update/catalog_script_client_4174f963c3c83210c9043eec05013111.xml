        <name>Validate Expense Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || newValue === "") {
        g_form.hideFieldMsg("expense_date", true);
        return;
    }

    var dateParts = newValue.split("/");
    var day = parseInt(dateParts[0], 10);
    var month = parseInt(dateParts[1], 10) - 1;
    var year = parseInt(dateParts[2], 10);
    var selectedDate = new Date(year, month, day);

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    if (selectedDate > today) {
        g_form.setValue("expense_date", "");
        g_form.showFieldMsg("expense_date", "A data da despesa não pode ser uma data futura.", "error", false);
        
    } else {

        g_form.hideFieldMsg("expense_date", true);
    }
}]]></script>
